import os
import requests
import glob
import rasterio
from rasterio.merge import merge
from rasterio.mask import mask
from rasterio.warp import calculate_default_transform, reproject, Resampling
from rasterio.io import MemoryFile
from rasterio.errors import RasterioIOError
import geopandas as gpd
from shapely.geometry import mapping
from pystac_client import Client
from planetary_computer import sign
from multiprocessing import Pool

# === CONFIGURATION === 
year = 2018
tile_shapefile = "/volumes/cchr/Fgorgin/NC_2018/NC_10km_tiles.shp"
us_shapefile = "/volumes/cchr/Fgorgin/US shapefile/tl_2024_us_state.shp"
base_dir = "/volumes/cchr/Fgorgin/NC_2018"
min_ok_size = 100 * 1024  # 100 KB
num_workers = 10

# === Load tile geometries ===
tiles_4326 = gpd.read_file(tile_shapefile).to_crs("EPSG:4326").set_index("tile_id")
tiles_26916 = gpd.read_file(tile_shapefile).to_crs("EPSG:26916").set_index("tile_id")
us_states = gpd.read_file(us_shapefile)
nc_geom = us_states[us_states["STUSPS"] == "NC"].to_crs("EPSG:26916").geometry.values[0]
tile_ids = list(tiles_4326.index)

# === Helper functions ===
def is_valid_tiff(filepath):
    try:
        with rasterio.open(filepath) as src:
            _ = src.profile
        return True
    except RasterioIOError:
        return False

def download_image(item, out_fp):
    try:
        signed = sign(item)
        url = signed.assets["image"].href
        with requests.get(url, stream=True, timeout=120) as r:
            r.raise_for_status()
            with open(out_fp, "wb") as f:
                for chunk in r.iter_content(chunk_size=1 << 20):
                    if chunk:
                        f.write(chunk)
        return True
    except Exception as e:
        print(f"\t? Download failed: {item.id} | {e}")
        return False

# === Tile Processing ===
def process_tile(tile_id):
    download_dir = os.path.join(base_dir, f"{tile_id}_Images")
    output_dir = os.path.join(base_dir, f"{tile_id}_Output")
    output_fp = os.path.join(output_dir, f"{tile_id}_mosaic_clipped.tif")
    os.makedirs(download_dir, exist_ok=True)
    os.makedirs(output_dir, exist_ok=True)

    if os.path.exists(output_fp) and os.path.getsize(output_fp) >= min_ok_size:
        print(f"? Skipping {tile_id}; valid output exists.")
        return

    try:
        tile_geom_4326 = tiles_4326.loc[tile_id].geometry
        tile_geom_26916 = tiles_26916.loc[tile_id].geometry
    except KeyError:
        print(f"? Tile {tile_id} not found.")
        return

    intersection = tile_geom_26916.intersection(nc_geom)
    if intersection.is_empty:
        print(f"? {tile_id} does not intersect North Carolina.")
        return
    tile_mask_geom = [mapping(intersection)]

    # === Clean up broken TIFFs from earlier runs
    existing_tifs = glob.glob(os.path.join(download_dir, "*.tif"))
    for tif in existing_tifs:
        if not is_valid_tiff(tif) or os.path.getsize(tif) < min_ok_size:
            print(f"?? Removing bad TIFF: {os.path.basename(tif)}")
            try:
                os.remove(tif)
            except Exception as e:
                print(f"? Failed to remove {tif}: {e}")

    print(f"?? Querying STAC for {tile_id}...")
    try:
        client = Client.open("https://planetarycomputer.microsoft.com/api/stac/v1")
        search = client.search(
            collections=["naip"],
            intersects=tile_geom_4326.__geo_interface__,
            datetime=f"{year}-01-01/{year}-12-31",
            limit=200
        )
        items = list(search.items())
        print(f"?? {tile_id}: {len(items)} images found")
    except Exception as e:
        print(f"? STAC query failed for {tile_id}: {e}")
        return

    tif_files = []
    for item in items:
        out_fp = os.path.join(download_dir, f"{item.id}.tif")

        if not os.path.exists(out_fp) or not is_valid_tiff(out_fp) or os.path.getsize(out_fp) < min_ok_size:
            print(f"?? Replacing corrupted or small TIFF: {item.id}")
            try:
                if os.path.exists(out_fp):
                    os.remove(out_fp)
            except Exception as e:
                print(f"? Failed to remove corrupted file {out_fp}: {e}")
            if not download_image(item, out_fp):
                continue

        if is_valid_tiff(out_fp) and os.path.getsize(out_fp) >= min_ok_size:
            tif_files.append(out_fp)

    if not tif_files:
        print(f"? No usable TIFFs for {tile_id}")
        return

    src_files, reproj_files = [], []
    for fp in tif_files:
        try:
            with rasterio.open(fp) as src:
                if src.crs.to_string() != "EPSG:26916":
                    print(f"?? Reprojecting {fp}")
                    dst_fp = fp.replace(".tif", "_reproj.tif")
                    dst_transform, width, height = calculate_default_transform(
                        src.crs, "EPSG:26916", src.width, src.height, *src.bounds)
                    kwargs = src.meta.copy()
                    kwargs.update({
                        'crs': "EPSG:26916",
                        'transform': dst_transform,
                        'width': width,
                        'height': height
                    })
                    with rasterio.open(dst_fp, 'w', **kwargs) as dst:
                        for i in range(1, src.count + 1):
                            reproject(
                                source=rasterio.band(src, i),
                                destination=rasterio.band(dst, i),
                                src_transform=src.transform,
                                src_crs=src.crs,
                                dst_transform=dst_transform,
                                dst_crs="EPSG:26916",
                                resampling=Resampling.nearest)
                    src_files.append(rasterio.open(dst_fp))
                    reproj_files.append(dst_fp)
                else:
                    src_files.append(src)
        except Exception as e:
            print(f"? Skipping {fp}: {e}")

    if not src_files:
        print(f"? No usable TIFFs after reprojection for {tile_id}")
        return

    print(f"?? Mosaicking {len(src_files)} files for {tile_id}...")
    mosaic, mosaic_transform = merge(src_files)
    meta = src_files[0].meta.copy()
    for s in src_files:
        s.close()

    meta.update({
        "height": mosaic.shape[1],
        "width": mosaic.shape[2],
        "transform": mosaic_transform
    })

    try:
        with MemoryFile() as memfile:
            with memfile.open(**meta) as tmp_dst:
                tmp_dst.write(mosaic)
            with memfile.open() as tmp_src:
                clipped, clipped_transform = mask(
                    tmp_src, shapes=tile_mask_geom, crop=True, filled=True, nodata=0)
        meta.update({
            "height": clipped.shape[1],
            "width": clipped.shape[2],
            "transform": clipped_transform
        })
        with rasterio.open(output_fp, "w", **meta) as dst:
            dst.write(clipped)
        print(f"? Saved clipped mosaic for {tile_id}")
    except Exception as e:
        print(f"? Clip failed for {tile_id}: {e}")
        return

    for f in reproj_files:
        try:
            os.remove(f)
            print(f"??? Deleted temp file: {f}")
        except Exception as e:
            print(f"?? Could not delete {f}: {e}")

# === Parallel Execution ===
if __name__ == "__main__":
    print(f"?? Starting parallel processing with {num_workers} workers...")
    with Pool(processes=num_workers) as pool:
        pool.map(process_tile, tile_ids)
    print("? All tiles processed.")
